# Merchant FinPilot — environment template.
# Copy to .env and fill in. NEVER commit .env.
#
# Rule: every secret is read from the environment at runtime.
# No credential is ever hardcoded, logged, or written into an AuditEvent.

# ---------------------------------------------------------------------------
# Razorpay (TEST MODE ONLY for the Buildathon build)
# ---------------------------------------------------------------------------
# Obtain from the Razorpay Dashboard. Test-mode keys are prefixed rzp_test_.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Secret configured on the Razorpay webhook endpoint. Used to verify the
# HMAC-SHA256 signature of the raw request body. Unverified webhooks are dropped.
RAZORPAY_WEBHOOK_SECRET=

# Hard guard: the execution layer refuses to run against live mode.
# Allowed values: test | live
RAZORPAY_MODE=test

# ---------------------------------------------------------------------------
# LLM (reasoning only — never a source of financial truth)
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
FINPILOT_AGENT_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
FINPILOT_ENV=development
FINPILOT_DATABASE_URL=sqlite:///./finpilot.sqlite3

# Deterministic seed for synthetic dataset generation.
FINPILOT_DATASET_SEED=20260826

# Global execution kill switch. When false, the execution layer performs no
# outbound consequential action regardless of any ALLOW decision.
FINPILOT_EXECUTION_ENABLED=false
