# Merchant FinPilot Environment Configuration (Template)
# Copy to .env for local deployment. DO NOT commit real keys to source control.

# Operation Mode: 'mock' (offline deterministic, no API key needed) or 'real' (live Gemini API)
FINPILOT_MODE=mock

# Google Gemini Configuration (Required ONLY if FINPILOT_MODE=real)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Database Configuration (Default is in-memory ':memory:' for stateless/test runs)
FINPILOT_DB_PATH=:memory:

# Server Configuration
FINPILOT_HOST=127.0.0.1
FINPILOT_PORT=8000

# Frontend Configuration (Vite)
# In development, leave blank or point to http://127.0.0.1:8000
# In production, point to the deployed Render backend
VITE_API_BASE_URL=https://merchant-finpilot-api.onrender.com

# Razorpay Integration Configuration (Credentials loaded from environment only)
RAZORPAY_KEY_ID=rzp_test_your_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# Execution Mode: 'simulated' (safe default) or 'razorpay_test' (calls Razorpay TEST API)
FINPILOT_EXECUTION_MODE=simulated

